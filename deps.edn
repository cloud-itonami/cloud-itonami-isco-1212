{:paths ["src"]
 ;; kotoba-lang/langgraph is hr-management.actor's StateGraph runtime
 ;; (zero-/single-dep, all .cljc -> portable to JVM / SCI /
 ;; ClojureScript / GraalVM, same layering as the other cloud-itonami
 ;; actors, e.g. cloud-itonami-isco-1213 / cloud-itonami-isco-4311 /
 ;; cloud-itonami-isco-2411 / cloud-itonami-isco-1211).
 :deps {io.github.kotoba-lang/langgraph
        {:git/sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
